{
    outerUnchanged: value1
    outerNested: {
        nestedUnchanged: nestedValue
      + nestedAdded: addedNestedValue
      - nestedRemoved: removedNestedValue
        nestedDeep: {
          - deepChanged: oldDeepValue
          + deepChanged: newDeepValue
        }
    }
  + outerAdded: {
        addedNestedKey: addedNestedValue
    }
  - outerRemoved: {
        removedNestedKey: removedNestedValue
    }
  - outerChanged: {
        oldNestedKey: oldNestedValue
    }
  + outerChanged: {
        newNestedKey: newNestedValue
    }
}